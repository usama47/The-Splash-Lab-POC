# Backend (also mirrored in backend/src/TheSplashLab.Api/appsettings.json)
# Copy values into environment or user-secrets for local MODE B testing.

ASPNETCORE_URLS=http://localhost:5080
ASPNETCORE_ENVIRONMENT=Development

# AI provider: Mock (default MODE A) or Claude (MODE B)
Ai__Provider=Mock
# ANTHROPIC_API_KEY=
# Ai__ClaudeModel=claude-3-5-sonnet-20241022

# Optional SQLite path override (empty = Data/splashlab-poc.db under API content root)
# Database__Path=

# Microsoft Graph placeholders — verify permissions from official Microsoft docs before enabling
# MicrosoftGraph__TenantId=
# MicrosoftGraph__ClientId=
# MicrosoftGraph__ClientSecret=

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:5080

# CORS — add public UI origins when deploying (see deploy.md)
# Cors__AllowedOrigins__0=http://localhost:3000
# Cors__AllowedOrigins__1=https://your-ui-host.example
