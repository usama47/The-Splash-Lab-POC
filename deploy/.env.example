# Copy to deploy/.env before docker compose up

# Public API URL baked into the Next.js build (must be reachable from the browser)
NEXT_PUBLIC_API_BASE=http://localhost:5080

# Comma-separated browser origins allowed by the API CORS policy
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Examples for a public demo:
# NEXT_PUBLIC_API_BASE=https://api.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://demo.yourdomain.com,http://localhost:3000
